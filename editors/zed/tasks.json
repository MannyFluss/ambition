// Ambition's press, as a Zed task. Copy this entry into ~/.config/zed/tasks.json
// (Zed: "zed: open tasks"). It saves the file, then sends the ^ line under the
// cursor. Its terminal stays hidden unless the press fails, so you see why.
[
  {
    "label": "Ambition: press",
    "command": "ambition",
    "args": ["fire", "$ZED_FILE:$ZED_ROW"],
    "save": "current",
    "reveal": "never",
    "hide": "on_success",
    "allow_concurrent_runs": true,
    "show_summary": false,
    "show_command": false
  }
]
